const express = require("express");
const path = require("path");

const app = express();
const PORT = 3000;

app.get("/", (req, res) => {
  res.cookie("HttpOnlyCookie", "value1", { httpOnly: true });
  res.cookie("SecureCookie", "value2", { secure: true, sameSite: "Strict" });

  res.sendFile(path.join(__dirname, "index.html"));
});

app.listen(PORT, () => {
  console.log(Server is running on http://localhost:${PORT});
});
